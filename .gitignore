# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# --- Environments ---------------------------------------------------------
# .python-version and uv.lock are deliberately NOT ignored: uv reads the first to
# provision the interpreter and the second to pin every version. Ignoring either
# hands each contributor a different environment, which is what uv is here to stop.
.venv/
venv/
env/

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# --- Data -----------------------------------------------------------------
# Corpora and intermediates are large and/or licence-encumbered. data/eval/ and
# data/lexicon/ ARE tracked: the eval set is the benchmark of record and the
# lexicons are product artifacts (SPELLING-SPEC.md §12).
data/raw/
data/work/
data/labels/
out/

# --- Media ----------------------------------------------------------------
*.wav
*.mp3
*.flac
*.m4a
*.mp4
*.mkv
*.mov
*.webm

# --- Model checkpoints ----------------------------------------------------
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
checkpoints/
runs/
wandb/
mlruns/

# --- Editors / OS ---------------------------------------------------------
.DS_Store
.idea/
*.swp

*.zip

# Scratch test scripts dropped at the repo root. Anchored, because unanchored
# this matched tests/test_*.py too and silently refused every new test file --
# the suite in tests/ survives only by predating the rule.
/test_*.py

# --- Credentials ----------------------------------------------------------
# The repository is public. Nothing here has ever contained a secret and it
# must stay that way, so the patterns are broad rather than minimal.
.env
.env.*
*.env
secrets.*
credentials.*
*token*.json
*token*.txt
*.pem
*.key
*.p12
id_rsa*
service-account*.json
.huggingface/
.hf_token

# --- Colab ----------------------------------------------------------------
# A .ipynb stores its OUTPUT cells. A printed token, a sample of the eval set
# or a stack trace with a path is saved into the file and committed with it.
# Clear all outputs before committing a notebook.
notebooks/**/.ipynb_checkpoints/
notebooks/**/*-checkpoint.ipynb
